# ============================================================
# 深度研究助手 · 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# 不配置 LLM 也能启动，但会以“离线模式”产出基础报告；
# 想要高质量深度研究报告，请务必配置 LLM_API_KEY。
# ============================================================

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
DEBUG=0

# ---------- Bocha 网页搜索 ----------
# 从课程文档/官网申请自己的 Key（sk- 开头）
BOCHA_API_KEY=sk-3d2293ad83aa4823a7c7ce8dd5ff8c72
# BOCHA_URL=https://api.bocha.cn/v1/web-search

# ---------- LLM（任意 OpenAI Chat Completions 兼容服务均可）----------
# 例1：DeepSeek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 例2：OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# 例3：通义/豆包/月之暗面等 OpenAI 兼容网关，替换 base_url/model 即可

# ---------- 研究流程参数（可选，都有合理默认值）----------
# MAX_ROUNDS=1            # 初始检索之外的“智能补检”轮次数（0~3）
# RESULTS_PER_QUERY=5     # 每个关键词返回几条搜索结果
# MAX_PAGES_TO_READ=8     # 最多“真实阅读”几个网页正文
# MAX_SOURCES_TOTAL=25    # 最终报告中保留的来源上限

# ---------- 任务 ----------
# TASK_TTL_SECONDS=3600   # 已完成任务在内存中的保留时长（秒）
