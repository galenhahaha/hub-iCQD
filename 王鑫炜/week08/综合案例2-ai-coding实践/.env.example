# 真实模式开关：real 才会调用免费搜索和 LLM；不设置则使用离线 mock
RESEARCH_MODE=real

# 免费搜索：duckduckgo 无需 API Key，适合本地练习；也可改成 bocha
SEARCH_PROVIDER=duckduckgo
SEARCH_COUNT=8

# 可选：Bocha 网页搜索（仅当 SEARCH_PROVIDER=bocha 时需要）
BOCHA_API_KEY=replace-with-your-bocha-key
BOCHA_BASE_URL=https://api.bocha.cn/v1/web-search
BOCHA_SEARCH_COUNT=8

# 任意 OpenAI Chat Completions 兼容服务；以下示例为 DeepSeek
LLM_API_KEY=replace-with-your-llm-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 可选运行参数
LLM_TIMEOUT=60
SEARCH_TIMEOUT=30
SEARCH_RETRIES=1
